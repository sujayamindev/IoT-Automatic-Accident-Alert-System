# Environment Configuration for IoT Accident Alert System Backend

# -------------------- FLASK CONFIGURATION --------------------
# Generate a secure secret key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-random-secret-key-change-in-production
FLASK_ENV=development
PORT=5000

# -------------------- FIREBASE CONFIGURATION --------------------
# Your Firebase project details
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_DATABASE_URL=https://your-firebase-project-default-rtdb.region.firebasedatabase.app
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json

# -------------------- DEVICE AUTHENTICATION --------------------
# Optional: Add device secret for extra security
# Leave empty to disable device secret validation
DEVICE_SECRET_KEY=

# -------------------- DATA RETENTION --------------------
# Telemetry data retention period in seconds (default: 1 hour = 3600 seconds)
TELEMETRY_RETENTION_SECONDS=3600

# -------------------- CORS CONFIGURATION --------------------
# In production, update CORS_ORIGINS in config.py to specific domains
# Example: ['https://yourdomain.com', 'https://app.yourdomain.com']
